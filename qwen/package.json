{
  "name": "qwen-node",
  "version": "0.1.0",
  "description": "Browser-free Qwen (chat.qwen.ai) guest client with OpenAI-style API, self-contained bundle, and HTTP server — ready to drop into a Docker/K8s container.",
  "main": "src/index.js",
  "bin": {
    "qwen-server": "./server.js"
  },
  "scripts": {
    "start": "node server.js",
    "warmup": "node -e \"require('./src').warmup({forceRefresh:true}).then(s => console.log(JSON.stringify(s, null, 2)))\"",
    "build": "node build-bundle.js"
  },
  "dependencies": {
    "jsdom": "^22.0.0",
    "undici": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
